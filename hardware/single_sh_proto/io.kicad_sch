	)
	(text "JST-SH 8P (BM08B-SRSS-TB), two 8 mm micro steppers per plug, one motor's coils on the outer pins and the other's on the inner ones:\npins 1 2 7 8 = even motor A1 A2 B1 B2 (cable's outer motor); pins 6 5 3 4 = odd motor A1 A2 B1 B2 (coils swapped, A reversed: firmware CONFIG_FLAG_SWAP_COILS / REVERSE)."
		(exclude_from_sim no)
		(at 20.32 69.85 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f3e1f66d-36bb-5b2a-936c-2e5ec2c8f83b")
	)
