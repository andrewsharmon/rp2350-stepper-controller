	)
	(text "JST-SH 8P (BM08B-SRSS-TB), two 8 mm micro steppers per plug: pins 1-4 = first motor A1 A2 B1 B2, pins 5-8 = second motor.\nFirmware remaps coil order and polarity per axis, so lead-colour variations are fixed in software."
		(exclude_from_sim no)
		(at 20.32 69.85 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2ae8a555-67c8-51e8-86c2-6e93497ace24")
	)
